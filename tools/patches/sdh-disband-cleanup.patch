+    findPlayer(id) {
+        // A reconnect can race with Redis cleanup. Do not admit it to a closing table.
+        if (this._status === TABLE_STATUS.DESTORY) return undefined;
+        return super.findPlayer(id);
+    }
+
+    destroy(reason) {
+        if (this._destroyPromise || this._status === TABLE_STATUS.DESTORY) return this._destroyPromise;
+        this._status = TABLE_STATUS.DESTORY;
+        if (this._job) this._job.cancel();
+        const players = this._players.filter(player => player.exists);
+        const removeBindings = async () => {
+            const results = await Promise.allSettled(players.map(async player => {
+                // Only remove this table's binding; a newer seat must survive.
+                const result = await RedisHelper.delPlayerGameInfo(player.id, this._tableID);
+                if (result === -1) throw new Error('Invalid player reconnect record during SDH disband');
+            }));
+            const failure = results.find(result => result.status === 'rejected');
+            if (failure) throw failure.reason;
+            await ioredis.hdel(`${REDIS_KEY.ROOM}:${this._clubID}:${this._roomID}`, this._tableID);
+        };
+        const cleanup = async () => {
+            for (let attempt = 0; ; attempt++) {
+                try {
+                    await removeBindings();
+                    break;
+                } catch (error) {
+                    this.error(error);
+                    if (attempt >= 2) return;
+                    await new Promise(resolve => setTimeout(resolve, 1000 * (attempt + 1)));
+                }
+            }
+            this.gameMessage(-1, ROUTE.SC_GAME_DESTORY, { reason });
+            players.forEach(player => { player._prop = null; });
+        };
+        this._destroyPromise = cleanup();
+        return this._destroyPromise;
+    }
