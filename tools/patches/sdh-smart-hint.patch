+// Read-only, bounded suggestions. Keep the existing table rules: when the
+// strict follow groups are empty, canPlayGroup permits any equal-size play.
+// Preference (same suit, smaller cards, no broken pair) is not legality.
+Calc.suggestPlays = function (hands, lead, trumpSuit) {
+  const n = lead ? lead.cards.length : 1;
+  if (!n || n > hands.length) return { choices: [], forced: false };
+  const frequencies = new Map();
+  hands.forEach(card => frequencies.set(card, (frequencies.get(card) || 0) + 1));
+  const suit = card => Calc.getEffectiveSuit(card, trumpSuit);
+  const rank = card => Calc.getCardRank(card, trumpSuit);
+  const cardCost = card => (lead && suit(card) !== lead.suit ? 50000 : 0) +
+    (frequencies.get(card) > 1 ? 2000 : 0) + rank(card) + Calc.getCardScore(card) * 10;
+  const strict = lead ? Calc.getFollowableGroups(hands, lead, trumpSuit) : [];
+  const choices = new Map();
+  const add = cards => {
+    const key = cards.slice().sort((a, b) => a - b).join(',');
+    if (!choices.has(key)) choices.set(key, cards);
+  };
+  if (strict.length) {
+    strict.forEach(add); // The exact groups accepted by canPlayGroup.
+  } else {
+    const ordered = hands.slice().sort((a, b) => cardCost(a) - cardCost(b) || a - b);
+    const base = ordered.slice(0, n);
+    add(base);
+    // A small selection of alternative plays is enough; never enumerate all
+    // n-card subsets of a large hand.
+    const tail = [...new Set(ordered.slice(n))].slice(0, 8);
+    const used = new Set();
+    for (let i = n - 1; i >= 0 && used.size < 8; i--) {
+      if (used.has(base[i])) continue;
+      used.add(base[i]);
+      tail.forEach(card => add([...base.slice(0, i), card, ...base.slice(i + 1)]));
+    }
+  }
+  const cost = cards => {
+    const counts = new Map();
+    let result = 0;
+    cards.forEach(card => {
+      counts.set(card, (counts.get(card) || 0) + 1);
+      result += cardCost(card);
+    });
+    counts.forEach((count, card) => {
+      if (count === frequencies.get(card)) result -= count * (count > 1 ? 2000 : 0);
+    });
+    return result;
+  };
+  const forced = lead && (strict.length ? choices.size === 1 : n === hands.length || frequencies.size === 1);
+  return { choices: [...choices.values()].sort((a, b) => cost(a) - cost(b)).slice(0, 8), forced: !!forced };
+};
